#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

ENV=${1:-dev}
BUCKET="starlogz-deploy-${ENV}"
TF_DIR="infra/terraform"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "error: deployment requires a clean working tree"
  git status --short
  exit 1
fi

confirm() {
  local msg=$1
  echo ""
  echo "${msg}"
  [[ "${CI:-}" == "true" ]] && return 0
  read -rp "Continue? [y/N] " ans
  [[ "${ans}" == [yY] ]] || { echo "aborted."; exit 1; }
}

# Lists managed resources whose planned change is not a Lambda code update.
PLAN_GUARD_JQ='
  .resource_changes[]?
  | select(.mode == "managed")
  | select(
      (.change.actions != ["no-op"])
      and (.address != "aws_lambda_function.starlogz" or .change.actions != ["update"])
    )
  | "\(.address) (\(.change.actions | join(",")))"
'

check_plan() {
  local offenders
  offenders=$(terraform -chdir="${TF_DIR}" show -json output.tfplan | jq -r "${PLAN_GUARD_JQ}")
  [[ -z "${offenders}" ]] && return 0
  echo ""
  echo "plan changes resources other than a Lambda update:"
  while IFS= read -r line; do echo "  ${line}"; done <<<"${offenders}"
  if [[ "${CI:-}" == "true" ]]; then
    echo "error: refusing to apply infrastructure changes from CI; run terraform locally"
    exit 1
  fi
  confirm "Plan includes the changes above."
}

# Build
echo "==> building"
bun install --frozen-lockfile
if ! bun run proto:check; then
  echo "error: generated protobuf clients are not current"
  exit 1
fi
bun run build
# Lambda runs linux/amd64; building every target exhausts memory on hosted agents.
GOOS=linux GOARCH=amd64 goreleaser build --clean --snapshot --single-target
VERSION=$(jq -r .version dist/metadata.json)
echo "    version: ${VERSION}"

# Package
echo "==> packaging"
cp dist/starlogz_linux_amd64_v1/starlogz-server .
zip -j dist/function.zip infra/lambda/bootstrap starlogz-server

S3_KEY="${VERSION}/function.zip"

confirm "Upload dist/function.zip → s3://${BUCKET}/${S3_KEY}"
echo "==> uploading"
aws s3 cp dist/function.zip "s3://${BUCKET}/${S3_KEY}"

confirm "Run terraform plan (env=${ENV}, version=${VERSION})"
echo "==> initialising"
bin/tf-init -input=false
echo "==> planning"
terraform -chdir="${TF_DIR}" plan -input=false \
  -var "function_s3_key=${S3_KEY}" \
  -var "function_version=${VERSION}" \
  -out output.tfplan
check_plan

confirm "Run database migrations (env=${ENV})"
echo "==> migrating"
if [[ -n "${DATABASE_URL:-}" ]]; then
  # PgBouncer breaks the session advisory lock and CONCURRENTLY index builds.
  if [[ "${DATABASE_URL}" == *:6432* ]]; then
    echo "error: DATABASE_URL must use the direct port 5432, not PgBouncer (6432)"
    exit 1
  fi
  env -u SSM_SECRETS_PATH go run ./cmd/starlogz-server migrate
else
  SSM_SECRETS_PATH="${SSM_SECRETS_PATH:-/config/${ENV}/main/starlogz}" go run ./cmd/starlogz-server migrate
fi

confirm "Apply the plan?"
echo "==> applying"
terraform -chdir="${TF_DIR}" apply "output.tfplan"

echo ""
echo "==> deployed ${VERSION} to ${ENV}"
